; Engine configuration file.
; Trolley Dash - supermarket shelf platformer MVP

config_version=5

[application]

config/name="Trolley Dash"
run/main_scene="res://menu.tscn"
config/features=PackedStringArray("4.3")

[autoload]

; Sound effects, addressed by name. Silently does nothing for any sound whose
; file is absent, so the game runs with an empty audio/ folder.
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1152
window/size/viewport_height=648
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
